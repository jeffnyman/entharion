(understand [examine/look/read (number $N)] as [examine $N])

(understand [examine/look/read page (number $N)] as [examine $N])

(prevent [examine (number $N)])
	{ ($N < 418) (or) ($N > 445) }
	There's no page with that number in the (score extract).

(perform [examine (number $N)])
	($N divided by 2 into $NHalf)
	($NHalf plus $NHalf into $First)
	(flip to $First)

(flip to $NewP)
	(first face orchestra)
	($NewP plus 1 into $Second)
	(if) (#score is closed) (then)
		(now) (has opened the score)
		You open the score extract
		(if) ($NewP = 418) (then)
			on the first two pages, numbered 418-419 in this facsimile edition.
		(elseif) ($NewP = 444) (then)
			on the last two pages, numbered 444-445 in this facsimile edition.
		(else)
			and locate pages $NewP - $Second.
		(endif)
		(par)
		(now) (#score is open)
		(now) (#currpage is #partof *)
		(now) (#nextpage is #partof *)
		(now) (#prevpage is #partof *)
		(now) (current page $NewP)
	(else)
		(if) (current page $NewP) (then)
			You study
		(else)
			(now) (current page $NewP)
			You (select) turn (or) flip (purely at random) to
		(endif)
		pages $NewP - $Second.
	(endif)
	(par)
	(descr page)

