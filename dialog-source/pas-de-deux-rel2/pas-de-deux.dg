~(refuse [turn to $])

(prevent [turn to (number $N)])
	{ ($N < 418) (or) ($N > 445) }
	There's no page with that number in the (score extract).

(perform [turn to (number $N)])
	($N divided by 2 into $NHalf)
	($NHalf plus $NHalf into $First)
	(if) (#score is open) (current page $First) (then)
		The (score extract) is already open on that page.
