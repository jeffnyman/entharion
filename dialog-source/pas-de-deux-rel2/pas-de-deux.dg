%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Metadata

(story title)	Pas De Deux
(story noun)	An Interactive Performance
(story author)	Linus Åkesson
(story ifid)	34EAC412-BAC2-49BE-9FEB-75E4147A82D4
(story release 2)

(story blurb)

	Striding into the spotlight, you smile as you look out over the crowd.
	It's a good turnout tonight. Now it is up to the Bournebrook Rill
	Community Orchestra and you, maestro Nevada Elmsbee, to deliver a
	spectacular performance.

	(par)

	Keep an eye on your score—or don't!—in this multi-layered parser/choice
	hybrid. Casually explore the interactive scene, or tackle the full
	puzzle lurking underneath to reach the best ending. Available for the
	web \(recommended\) and as a traditional Z-machine story file.

(style class @secondary)
	font-style: italic;
	margin-top: 1em;
	margin-bottom: 1em;
	margin-left: 4em;
	margin-right: 4em;
	text-align: left;

(style class @authornote)
	margin-top: 1em;
	margin-bottom: 1em;
	margin-left: 4em;
	margin-right: 4em;

(style class @spacer)
	margin-bottom: 1em;

(style class @centerspacer)
	margin-top: 1em;
	margin-bottom: 1em;
	text-align: center;

(style class @barheadline)
	font-weight: bold;
	font-style: normal;

(style class @clear)
	clear: left;

(style class @statuslinks)
	float: right;
	padding-left: 1ch;
	padding-right: 1ch;

(style class @status)
	height: 1em;

(style class @clipping)
	margin-top: 2em;
	margin-bottom: 2em;
	width: 30ch;
	margin-left: auto;
	margin-right: auto;
	border: 1px solid \#888;
	padding: .2em;
	text-align: justify;
	font-family: "Times New Roman", monospace;

(style class @picture)
	margin-top: 1em;
	margin-bottom: 1em;
	text-align: center;

(define resource @w) https://linusakesson.net/
(define resource @i) https://imslp.org/
(define resource @c) https://ifcomp.org/

(define resource 1) feelies/score.pdf
(define resource 2) feelies/how_to_read.pdf
(define resource 3) feelies/seating.pdf

(define resource #seating) seating/seating.png

(library links enabled)
(default actions enabled)

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Object order

%% A hack to force a particular order in "Did you mean the first violins or the
%% second violins?".

#violin1
#violin2

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Rules of overriding priority

(prevent $Action)
	(current room #kitchen)
	~(command $Action)
	~($Action = [examine | $])
	~($Action = [wait])
	~($Action = [inventory])
	~($Action = [look])
	~(#newspaper is one of $Action)

	But you're anxious to find out what the (link [paper]) paper has to
	say about last night.

(on every tick)
	(current room #hall)
	(div @clear) {}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Cutscenes

(intro)
	(status bar @status) { (story title) }

	(if) (interpreter supports links) (then)
		This
	(else)
		Note: The web version of this
	(endif)
	game can be played by typing commands at the prompt, or by
	clicking on highlighted words. It is possible to reach a good ending
	using either method, but some typing is required to unlock every part
	of the narrative.

	(par)

	For an authentic experience, please print out a double-sided copy of
	the enclosed (link resource 1) {score extract}, and make notes with a
	soft pencil.

	(par)

	Before we begin, a matter of preference: You are Nevada Elmsbee,
	artistic director of the Bournebrook Rill Community Orchestra, and you
	have a big performance tonight. Do you wear a (link [suit]) suit or a
	(link [dress]) dress ?

	(if) (ask about suit) (then)
		(now) (#suit is #wornby #maestro)
		(par) Suit it is.
	(else)
		(now) (#dress is #wornby #maestro)
		(par) Dress it is.
	(endif)

	(banner)

	(par)

	Type (link [about]) ABOUT for credits.

	(spacer)

	The applause begins the minute you enter the hall.

	(par)

	With practiced confidence, you stride into the spotlight and smile
	sincerely as you look out over the (link [crowd]) crowd . It's a good
	turnout tonight.

	(div @spacer) {}

	(try [look])
	(tick)

	(par)

	The (#audience) is still clapping wildly.

(ask about suit)
	*(repeat forever)
	(par)
	> (get input $Input)
	(handle first question $Input $Result)
	(just)
	($Result = 1)

(handle first question [suit] 1)
(handle first question [dress] 0)
(handle first question [a suit] 1)
(handle first question [a dress] 0)
(handle first question [script/transcript | $More] $)
	{ ($More = []) (or) ($More = [on]) }
	(if) (transcript on) (then)
		Transcript enabled.
	(else)
		Failed to enable transcript.
	(endif)
	(par)
	(fail)
(handle first question [about/credits] $)
	(perform [about])
	(par)
	(fail)
(handle first question [quit/q] $)
	(quit)
(handle first question [restore] $)
	(restore)
	Failed to restore the game state.
	(par)
	(fail)
(handle first question $ $)
	(line)
	Please select (link [suit]) SUIT or (link [dress]) DRESS .
	(fail)

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Evaluation

(global variable (good cues 0))
(global variable (bad cues 0))

%% A maximum of 23 good cues can be collected.

(good cue)
	(good cues $Old)
	($Old plus 1 into $New)
	(now) (good cues $New)

%% A maximum of 25 bad cues can be collected.

(bad cue)
	(bad cues $Old)
	($Old plus 1 into $New)
	(now) (bad cues $New)

(global variable (final result 1))

(evaluate)
	(good cues $Good)
	(bad cues $Bad)
	(if) ($Good > 20) ($Bad = 0) (then)
		(now) (final result 5)
	(elseif) ($Good > 16) ($Bad < 2) (then)
		(now) (final result 4)
	(elseif) ($Good > 4) ($Good > $Bad) (then)
		(now) (final result 3)
	(else)
		(now) (final result 2)
	(endif)

