	(now) ~(facing audience)
	(now) ~(facing sideways)
	(exhaust) {
		*($O has parent #maestro)
		(now) ($O is nowhere)
	}
	(now) (#pyjamas is #wornby #maestro)
	(enter #kitchen)
	(stop)

