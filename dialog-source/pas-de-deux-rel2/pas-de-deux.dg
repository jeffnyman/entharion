#hall
(name *)		concert hall
(dict *)		auditorium
(singleton *)
(room *)
(look *)

	(link [myself]) You are standing at the focal point of the (#stage
	{grand stage}) of the

	(select)
		Bournebrook Rill Concert Hall.
		(par)
		(descr *)
	(or)
		(* {Bournebrook Rill Concert Hall}).
	(stopping)

	(par)
	(if) ~(facing audience) ~(facing sideways) (then)
