#audience
(name *)		audience
(singleton *)
(dict *)

	community people listeners listener crowd gallery public darkness dark
	faces annoying member local upper crust press politicians coterie
	friends

(* is #in #hall)
(out of reach *)

(audience is lit)
(facing audience)

(descr *)
	(face audience)

	(if) (did trainwreck) (then)
		(select)
			(par)

			They're not to blame, of course. How were they to know
			that the piece wasn't over?

			(par)

			You muster a benevolent smile.
		(or)
			The audience is clapping wildly.
		(stopping)
	(else)
		(if) (#applause has parent #hall) ~(bar 0) (then)
			(select)
				(if) (final result 5) (then)

					Rows upon rows of beaming, clapping
					people.

				(else)

					Oh for crying out loud, they're
					standing up. Don't these people have
					any sense of integrity?

				(endif)
				(par)
				You smile genially.
			(or)
				The audience is clapping wildly.
			(stopping)
			(par)
		(endif)

		It's a full house.
		(if) (audience is lit) (then)

			Press, politicians, and the local upper crust, mixed
			with

		(else)

			You can't discern any faces in the darkness, but this
			crowd is unmistakably larger than

		(endif)

		the usual coterie of friends and relatives of
		
		(select)
			orchestra members.

			In a unique collaboration with the town council,
			tonight's concert is a fundraiser for a new “mallard
			habitat” in the Botanic Garden, and you suspect that a
			large proportion of the crowd are here primarily to
			wallow in their own benevolence.
		
			(if) (bar 0) (then)
				(par)

				Not that any of that matters, of course. The
				music does. The music and the (#orchestra).

			(endif)
		(or)
			(#orchestra) members.
		(stopping)
	(endif)

(prevent [turn to *])
	{ (facing audience) (or) (facing sideways) }
	You're already looking at the audience.

(perform [turn to *])
	(face audience)

(face audience)
	(maybe prevent facing audience)
	(if) ~(facing audience) ~(facing sideways) (then)
		(bar $N)
		(if) ($N > 0) ($N < 74) (then)

			You turn your body sideways and smile towards the audience, while
			continuing to conduct the (#orchestra) with your right hand.

			(now) (facing sideways)
		(else)
			You turn to face the audience.
			(now) (facing audience)
		(endif)
		(par)
		(now) (current gaze #audience)
	(endif)

(first face audience)
	(maybe prevent facing audience)
	(if) ~(facing audience) ~(facing sideways) (then)
		(bar $N)
		(if) ($N > 0) ($N < 74) (then)

			You turn your body sideways and smile towards the audience, while
			continuing to conduct the (#orchestra) with your right hand.

			(now) (facing sideways)
		(else)
			\( first turning to face the audience \)
			(now) (facing audience)
		(endif)
		(par)
		(now) (current gaze #audience)
	(endif)

(maybe prevent facing audience)
	(bar $Bar)
	(if) ($Bar > 73) (#applause is nowhere) (then)
		(link [wait]) Wait for it...
		(stop)
	(endif)

(face orchestra)
	(if) (facing audience) (or) (facing sideways) (then)
		You turn to face the (#orchestra).
		(par)
		(now) ~(facing audience)
		(now) ~(facing sideways)
	(endif)

(first face orchestra)
	(if) (facing audience) (or) (facing sideways) (then)
		\( first turning to face the (#orchestra) \)
		(par)
		(now) ~(facing audience)
		(now) ~(facing sideways)
	(endif)

