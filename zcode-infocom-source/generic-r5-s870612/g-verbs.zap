

	.FUNCT	V-VERBOSE
	SET	'VERBOSE,TRUE-VALUE
	SET	'SUPER-BRIEF,FALSE-VALUE
	PRINTI	"(Maximum verbosity.)"
	CRLF	
	CRLF	
	CALL	V-LOOK
	RSTACK	


	.FUNCT	V-BRIEF
	SET	'VERBOSE,FALSE-VALUE
	SET	'SUPER-BRIEF,FALSE-VALUE
	PRINTR	"(Brief descriptions.)"


	.FUNCT	V-SUPER-BRIEF
	SET	'SUPER-BRIEF,TRUE-VALUE
	PRINTR	"(Super-brief descriptions.)"


	.FUNCT	V-INVENTORY
	PRINTI	"You're "
	FIRST?	PROTAGONIST \?PRG8
	PRINTI	"holding "
	CALL	PRINT-CONTENTS,PROTAGONIST
	JUMP	?PRG10
?PRG8:	PRINTI	"not holding anything"
?PRG10:	PRINTR	"."


	.FUNCT	SAY-SURE
	PRINTI	"Are you sure you want to "
	RTRUE	


	.FUNCT	V-QUIT,ASK?=1,SCOR
	CALL	V-SCORE
	ZERO?	ASK? /?CCL3
	CALL	SAY-SURE
	PRINTI	"leave the story now?"
	CALL	YES?
	ZERO?	STACK /?PRG9
	QUIT	
	RTRUE	
?PRG9:	PRINT	OKAY
	PRINTR	"continuing."
?CCL3:	QUIT	
	RTRUE	


	.FUNCT	V-RESTART
	CALL	V-SCORE
	CALL	SAY-SURE
	PRINTI	"restart the story?"
	CALL	YES?
	ZERO?	STACK /FALSE
	RESTART	
	CALL	FAILED
	RSTACK	


	.FUNCT	FINISH,REPEATING=0,WORD
	CRLF	
	ZERO?	REPEATING \?PRG3
	CALL	V-SCORE
	CRLF	
?PRG3:	PRINTI	"Do you want to restart the story, restore a saved position, or quit?

(Type RESTART, RESTORE or QUIT.)
>"
	READ	P-INBUF,P-LEXV
	GET	P-LEXV,1 >WORD
	EQUAL?	WORD,W?RESTAR \?CCL7
	RESTART	
	CALL	FAILED
	CALL	FINISH,TRUE-VALUE
	RSTACK	
?CCL7:	EQUAL?	WORD,W?RESTOR \?CCL9
	RESTORE	 \?CCL12
	CALL	SAY-OKAY
	RSTACK	
?CCL12:	CALL	FAILED
	CALL	FINISH,TRUE-VALUE
	RSTACK	
?CCL9:	QUIT	
	RTRUE	


	.FUNCT	YES?,WORD
	CRLF	
?PRG1:	CRLF	
	PRINTI	"(Please type YES or NO.) >"
	PUTB	YES-LEXV,0,4
	READ	YES-INBUF,YES-LEXV
	GET	YES-LEXV,P-LEXSTART >WORD
	GETB	YES-LEXV,P-LEXWORDS
	ZERO?	STACK /?PRG1
	ZERO?	WORD /?PRG1
	EQUAL?	WORD,W?YES,W?Y,W?YUP /TRUE
	EQUAL?	WORD,W?OKAY,W?OK,W?AYE /TRUE
	EQUAL?	WORD,W?SURE,W?AFFIRM,W?POSITI /TRUE
	EQUAL?	WORD,W?NO,W?N,W?NOPE /FALSE
	EQUAL?	WORD,W?NAY,W?NAW,W?NEGATIVE \?PRG1
	RFALSE	


	.FUNCT	SAY-OKAY
	PRINT	OKAY
	PRINTR	"done."


	.FUNCT	FAILED
	PRINTR	"Failed."


	.FUNCT	V-RESTORE
	RESTORE	 \?CCL3
	CALL	SAY-OKAY
	RSTACK	
?CCL3:	CALL	FAILED
	RSTACK	


	.FUNCT	V-SAVE
	SAVE	 \?CCL3
	CALL	SAY-OKAY
	RSTACK	
?CCL3:	CALL	FAILED
	RSTACK	


	.FUNCT	V-SCORE
	PRINTI	"Your score is "
	PRINTN	SCORE
	PRINTI	" point"
	EQUAL?	SCORE,1 /?PRG7
	PRINTC	115
?PRG7:	PRINTI	" out of 100, in "
	PRINTN	MOVES
	PRINTI	" move"
	EQUAL?	MOVES,1 /?PRG13
	PRINTC	115
?PRG13:	PRINTR	"."


	.FUNCT	V-TIME
	PRINTI	"It's "
	CALL	TELL-TIME
	PRINTR	"."


	.FUNCT	TELL-TIME,H,PM?=0
	GRTR?	SCORE,11 \?CND1
	SET	'PM?,TRUE-VALUE
?CND1:	GRTR?	SCORE,12 \?CCL5
	SUB	SCORE,12 >H
	JUMP	?PRG8
?CCL5:	ZERO?	SCORE \?CCL7
	SET	'H,12
	JUMP	?PRG8
?CCL7:	SET	'H,SCORE
?PRG8:	PRINTN	H
	PRINTC	58
	LESS?	MOVES,10 \?PRG14
	PRINTC	48
?PRG14:	PRINTN	MOVES
	ZERO?	PM? /?PRG21
	PRINTI	" pm"
	RTRUE	
?PRG21:	PRINTI	" am"
	RTRUE	


	.FUNCT	V-SCRIPT
	GET	0,8
	BOR	STACK,1
	PUT	0,8,STACK
	CALL	TRANSCRIPT,STR?38
	RTRUE	


	.FUNCT	V-UNSCRIPT
	CALL	TRANSCRIPT,STR?39
	GET	0,8
	BAND	STACK,-2
	PUT	0,8,STACK
	RTRUE	


	.FUNCT	TRANSCRIPT,STR
	PRINTI	"Here "
	PRINT	STR
	PRINTI	"s a transcript of interaction with"
	CRLF	
	CALL	V-VERSION
	RSTACK	


	.FUNCT	V-VERSION,CNT=17,V
	GET	0,1
	BAND	STACK,2047 >V
	CRLF	
	PRINTI	"GENERIC
Copyright (C) 1985 Infocom, Inc. All rights reserved."
	CRLF	
	GETB	0,1
	BTST	STACK,8 \?PRG7
	PRINTI	"Licensed to Tandy Corporation. Version 00.00."
	PRINTN	V
	CRLF	
?PRG7:	PRINTI	"GENERIC is a trademark of Infocom, Inc.
Release "
	PRINTN	V
	PRINTI	" / Serial Number "
?PRG9:	IGRTR?	'CNT,23 /?REP10
	GETB	0,CNT
	PRINTC	STACK
	JUMP	?PRG9
?REP10:	CRLF	
	RTRUE	


	.FUNCT	V-USE
	FSET?	PRSO,ACTORBIT \?CCL3
	CALL	BUT-THE,PRSO
	PRINTR	"might resent that."
?CCL3:	CALL	HOW?
	RSTACK	


	.FUNCT	V-$VERIFY
	ZERO?	PRSO /?PRG11
	EQUAL?	PRSO,INTNUM \?CCL6
	EQUAL?	P-NUMBER,93 \?CCL6
	PRINTN	SERIAL
	CRLF	
	RTRUE	
?CCL6:	CALL	DONT-UNDERSTAND
	RSTACK	
?PRG11:	PRINTI	"Verifying disk."
	CRLF	
	VERIFY	 \?CCL15
	PRINTR	"Correct."
?CCL15:	CALL	FAILED
	RSTACK	


	.FUNCT	V-ALARM
	EQUAL?	PRSO,ME,ROOMS \?CCL3
	PRINTI	"But you're "
	JUMP	?PRG10
?CCL3:	FSET?	PRSO,ACTORBIT \?CCL7
	CALL	BUT-THE,PRSO
	PRINTI	"is "
?PRG10:	PRINTR	"already wide awake!"
?CCL7:	CALL	WHAT-A-CONCEPT
	RTRUE	


	.FUNCT	V-ASK-ABOUT
	CALL	V-ASK-FOR
	RSTACK	


	.FUNCT	V-QUESTION
	CALL	V-ASK-FOR
	RSTACK	


	.FUNCT	V-WAVE-AT
	CALL	V-ASK-FOR
	RSTACK	


	.FUNCT	V-ASK-FOR
	EQUAL?	PRSO,ME,ROOMS \?CCL3
	CALL	PERFORM,V?TELL,ME
	JUMP	?CND1
?CCL3:	CALL	NOT-LIKELY,PRSO,STR?40
?CND1:	CALL	PCLEAR
	RETURN	2


	.FUNCT	V-BITE
	CALL	HACK-HACK,STR?41
	RSTACK	


	.FUNCT	V-BLOW-INTO
	FSET?	PRSO,ACTORBIT \?CCL3
	CALL	PERFORM,V?USE,PRSO
	RTRUE	
?CCL3:	CALL	HACK-HACK,STR?42
	RSTACK	


	.FUNCT	V-BURN
	PRINTI	"With "
	CALL	ARTICLE,PRSI
	PRINTD	PRSI
	PRINTI	"? "
	CALL	PICK-ONE,YUKS
	PRINT	STACK
	CRLF	
	RTRUE	


	.FUNCT	V-BUY
	CALL	VISIBLE?,PRSO
	ZERO?	STACK \?CCL3
	CALL	CANT-SEE-ANY,PRSO
	RTRUE	
?CCL3:	FSET?	PRSO,TAKEBIT /?CCL5
	FSET?	PRSO,TRYTAKEBIT /?CCL5
	PRINT	CANT
	PRINTR	" buy that!"
?CCL5:	CALL	HELD?,PRSO
	ZERO?	STACK /?CCL11
	PRINTR	"You already have one."
?CCL11:	ZERO?	PRSI /?PRG16
	CALL	NOT-LIKELY,PRSI,STR?43
	RSTACK	
?PRG16:	PRINTR	"You don't have any money."


	.FUNCT	V-CLEAN
	CALL	NOT-A,STR?44
	RSTACK	


	.FUNCT	V-CLIMB-DOWN
	EQUAL?	PRSO,ROOMS \?CCL3
	CALL	DO-WALK,P?DOWN
	RSTACK	
?CCL3:	CALL	WHAT-A-CONCEPT
	RSTACK	


	.FUNCT	V-CLIMB-ON
	PRINT	CANT
	PRINTR	" climb onto that."


	.FUNCT	V-CLIMB-OVER
	EQUAL?	PRSO,ROOMS \?PRG4
	CALL	V-WALK-AROUND
	RSTACK	
?PRG4:	PRINT	CANT
	PRINTR	" climb over that."


	.FUNCT	V-CLIMB-UP
	EQUAL?	PRSO,ROOMS \?CCL3
	CALL	DO-WALK,P?UP
	RSTACK	
?CCL3:	CALL	WHAT-A-CONCEPT
	RSTACK	


	.FUNCT	V-CLOSE
	FSET?	PRSO,ACTORBIT \?CCL3
	CALL	NOT-A,STR?45
	RSTACK	
?CCL3:	FSET?	PRSO,SURFACEBIT \?CCL5
	CALL	CANT-CLOSE-THAT
	RSTACK	
?CCL5:	FSET?	PRSO,CONTBIT /?CCL7
	FSET?	PRSO,DOORBIT /?CCL7
	CALL	PERFORM,V?OPEN,PRSO
	RTRUE	
?CCL7:	FSET?	PRSO,SURFACEBIT /?CCL11
	GETP	PRSO,P?CAPACITY
	ZERO?	STACK /?CCL11
	FSET?	PRSO,OPENBIT \?CCL16
	CALL	NOW-CLOSED-OR-OPEN,PRSO
	CALL	SAY-IF-NOT-LIT
	RSTACK	
?CCL16:	CALL	ALREADY-CLOSED
	RSTACK	
?CCL11:	FSET?	PRSO,DOORBIT \?CCL18
	FSET?	PRSO,OPENBIT \?CCL21
	CALL	NOW-CLOSED-OR-OPEN,PRSO
	RSTACK	
?CCL21:	CALL	ALREADY-CLOSED
	RSTACK	
?CCL18:	CALL	CANT-CLOSE-THAT
	RSTACK	


	.FUNCT	CANT-CLOSE-THAT
	PRINT	CANT
	PRINTR	" close that!"


	.FUNCT	NOW-CLOSED-OR-OPEN,THING,OPEN?=0
	CALL	THIS-IS-IT,THING
	PRINT	OKAY
	CALL	ARTICLE,PRSO,TRUE-VALUE
	PRINTD	PRSO
	PRINTI	" is now "
	ZERO?	OPEN? /?CCL7
	FSET	THING,OPENBIT
	PRINTI	"open"
	JUMP	?PRG12
?CCL7:	FCLEAR	THING,OPENBIT
	PRINTI	"closed"
?PRG12:	PRINTR	"."


	.FUNCT	V-COUNT
	CALL	WASTE-OF-TIME
	RSTACK	


	.FUNCT	V-COVER
	CALL	PERFORM,V?PUT-ON,PRSI,PRSO
	RTRUE	


	.FUNCT	V-CROSS
	PRINT	CANT
	PRINTR	" cross that!"


	.FUNCT	V-CUT
	CALL	NOT-LIKELY,PRSI,STR?46
	RSTACK	


	.FUNCT	V-DIG
	CALL	WASTE-OF-TIME
	RSTACK	


	.FUNCT	V-DRINK
	PRINT	CANT
	PRINTR	" drink that!"


	.FUNCT	V-DRINK-FROM
	CALL	WHAT-A-CONCEPT
	RSTACK	


	.FUNCT	V-DROP
	CALL	IDROP
	ZERO?	STACK /FALSE
	PRINTR	"Dropped."


	.FUNCT	IDROP
	CALL	DONT-HAVE?,PRSO
	ZERO?	STACK \FALSE
	IN?	PRSO,WINNER /?CCL5
	LOC	PRSO
	FSET?	STACK,OPENBIT /?CCL5
	PRINT	CANT
	PRINTI	" do that while "
	CALL	ARTICLE,PRSO,TRUE-VALUE
	PRINTD	PRSO
	CALL	IS-CLOSED
	CRLF	
	RFALSE	
?CCL5:	FSET?	PRSO,WORNBIT \?CND1
	CALL	TAKE-OFF-PRSO-FIRST
?CND1:	LOC	WINNER
	MOVE	PRSO,STACK
	RTRUE	


	.FUNCT	V-EAT
	CALL	NOT-LIKELY,PRSO,STR?47
	RSTACK	


	.FUNCT	V-ENTER,VEHICLE
	EQUAL?	PRSO,ROOMS \?CCL3
	CALL	DO-WALK,P?IN
	RTRUE	
?CCL3:	FSET?	PRSO,WEARBIT \?PRG6
	CALL	PRESUMABLY-YOU-WANT-TO,STR?48,PRSO
	CALL	PERFORM,V?WEAR,PRSO
	RTRUE	
?PRG6:	CALL	PICK-ONE,YUKS
	PRINT	STACK
	CRLF	
	RTRUE	


	.FUNCT	PRE-DUMB-EXAMINE
	ZERO?	LIT \?PRG4
	CALL	TOO-DARK
	RTRUE	
?PRG4:	PRINT	I-ASSUME
	PRINTI	" LOOK AT "
	CALL	ARTICLE,PRSO,TRUE-VALUE
	PRINTD	PRSO
	PRINTI	", not LOOK INSIDE or LOOK ON or LOOK UNDER or LOOK BEHIND "
	CALL	ARTICLE,PRSO,TRUE-VALUE
	PRINTD	PRSO
	PRINTI	".)"
	CRLF	
	CALL	PERFORM,V?EXAMINE,PRSO
	RTRUE	


	.FUNCT	V-DUMB-EXAMINE
	CALL	V-EXAMINE
	RSTACK	


	.FUNCT	PRE-EXAMINE
	ZERO?	LIT \FALSE
	CALL	TOO-DARK
	RTRUE	


	.FUNCT	V-EXAMINE
	FSET?	PRSO,DOORBIT \?CCL3
	PRINTI	"It looks like "
	CALL	ARTICLE,PRSO,TRUE-VALUE
	PRINTD	PRSO
	PRINTI	" is "
	FSET?	PRSO,OPENBIT \?PRG13
	PRINTI	"open"
	JUMP	?PRG15
?PRG13:	PRINTI	"closed"
?PRG15:	PRINTR	"."
?CCL3:	FSET?	PRSO,SURFACEBIT \?CCL18
	CALL	V-LOOK-ON
	RSTACK	
?CCL18:	FSET?	PRSO,CONTBIT \?PRG26
	FSET?	PRSO,OPENBIT /?CTR22
	FSET?	PRSO,TRANSBIT \?CCL23
?CTR22:	CALL	V-LOOK-INSIDE
	RSTACK	
?CCL23:	CALL	ITS-CLOSED,PRSO
	RSTACK	
?PRG26:	PRINTI	"You see nothing "
	CALL	PICK-ONE,YAWNS
	PRINT	STACK
	PRINTI	" about "
	CALL	ARTICLE,PRSO,TRUE-VALUE
	PRINTD	PRSO
	PRINTR	"."


	.FUNCT	V-EXIT
	CALL	DO-WALK,P?OUT
	RSTACK	


	.FUNCT	V-FILL
	ZERO?	PRSI \?CCL3
	PRINTR	"There's nothing to fill it with."
?CCL3:	CALL	HOW?
	RSTACK	


	.FUNCT	V-FIND,L
	LOC	PRSO >L
	EQUAL?	PRSO,ME,HANDS \?CCL3
	PRINTI	"You're right here"
	JUMP	?PRG41
?CCL3:	IN?	PRSO,PROTAGONIST \?CCL7
	PRINTI	"You're holding it"
	JUMP	?PRG41
?CCL7:	IN?	PRSO,HERE /?CTR10
	EQUAL?	PRSO,PSEUDO-OBJECT \?CCL11
?CTR10:	CALL	BUT-THE,PRSO
	PRINTI	"is right in front of you"
	JUMP	?PRG41
?CCL11:	IN?	PRSO,LOCAL-GLOBALS \?CCL17
	CALL	HOW?
	RTRUE	
?CCL17:	FSET?	L,ACTORBIT \?CCL19
	CALL	VISIBLE?,L
	ZERO?	STACK /?CCL19
	PRINTI	"It looks like "
	CALL	ARTICLE,L,TRUE-VALUE
	PRINTD	L
	PRINTI	" has it"
	JUMP	?PRG41
?CCL19:	CALL	SEE-INSIDE?,L
	ZERO?	STACK /?PRG39
	CALL	VISIBLE?,L
	ZERO?	STACK /?PRG39
	PRINTI	"It's "
	FSET?	L,SURFACEBIT \?PRG37
	PRINTI	"on "
	JUMP	?CND32
?PRG37:	PRINTI	"in "
?CND32:	CALL	ARTICLE,L,TRUE-VALUE
	PRINTD	L
	JUMP	?PRG41
?PRG39:	PRINTI	"You'll have to do that yourself"
?PRG41:	PRINTR	"."


	.FUNCT	V-FIRST-LOOK
	CALL	DESCRIBE-ROOM
	ZERO?	STACK /FALSE
	ZERO?	SUPER-BRIEF \FALSE
	CALL	DESCRIBE-OBJECTS
	RSTACK	


	.FUNCT	V-FLY
	PRINT	CANT
	PRINTR	" do that!"


	.FUNCT	V-FOLLOW,WHERE
	LOC	PRSO >WHERE
	CALL	BUT-THE,PRSO
	PRINTI	"is "
	EQUAL?	WHERE,HERE /?PRG8
	CALL	GLOBAL-IN?,PRSO,HERE
	ZERO?	STACK /?CCL5
?PRG8:	PRINTI	"right here in front of you"
	JUMP	?PRG22
?CCL5:	EQUAL?	WHERE,PROTAGONIST \?CCL11
	PRINTI	"in "
	PRINTD	HANDS
	PRINTC	115
	JUMP	?PRG22
?CCL11:	IN?	WHERE,PROTAGONIST \?PRG20
	PRINTI	"in "
	CALL	ARTICLE,WHERE,TRUE-VALUE
	PRINTD	WHERE
	JUMP	?PRG22
?PRG20:	PRINTI	"nowhere to be seen"
?PRG22:	PRINTR	"!"


	.FUNCT	PRE-FEED
	CALL	PRE-GIVE,TRUE-VALUE
	ZERO?	STACK /FALSE
	RTRUE	


	.FUNCT	V-FEED
	CALL	V-GIVE,TRUE-VALUE
	RSTACK	


	.FUNCT	V-SFEED
	CALL	PERFORM,V?FEED,PRSI,PRSO
	RTRUE	


	.FUNCT	PRE-GIVE,FEED?=0
	ZERO?	PRSO /?CTR2
	ZERO?	PRSI \?CCL3
?CTR2:	CALL	REFERRING
	RTRUE	
?CCL3:	IN?	PRSO,LOCAL-GLOBALS /?CTR6
	IN?	PRSO,PSEUDO-OBJECT \?CCL7
?CTR6:	CALL	NOT-HOLDING
	RTRUE	
?CCL7:	CALL	DONT-HAVE?,PRSO
	ZERO?	STACK \TRUE
	FSET?	PRSI,ACTORBIT /?CCL13
	PRINT	CANT
	ZERO?	FEED? /?PRG21
	PRINTI	" feed"
	JUMP	?PRG23
?PRG21:	PRINTI	" give"
?PRG23:	PRINTR	" anything to that!"
?CCL13:	FSET?	PRSO,WORNBIT \FALSE
	CALL	TAKE-OFF-PRSO-FIRST
	RFALSE	


	.FUNCT	V-SGIVE
	CALL	PERFORM,V?GIVE,PRSI,PRSO
	RTRUE	


	.FUNCT	V-GIVE,FEED?=0
	FSET?	PRSI,ACTORBIT \?PRG8
	PRINTI	"Politely, "
	CALL	ARTICLE,PRSI,TRUE-VALUE
	PRINTD	PRSI
	PRINTR	" refuses your offer."
?PRG8:	PRINT	CANT
	ZERO?	FEED? /?PRG15
	PRINTI	" feed "
	JUMP	?CND10
?PRG15:	PRINTI	" give "
?CND10:	CALL	ARTICLE,PRSO
	PRINTD	PRSO
	PRINTI	" to "
	CALL	ARTICLE,PRSI
	PRINTD	PRSI
	PRINTR	"!"


	.FUNCT	V-HELLO,WHO
	ZERO?	PRSO /?CCL3
	SET	'WHO,PRSO
?CND1:	ZERO?	WHO /?CCL8
	FSET?	WHO,ACTORBIT \?CCL11
	PRINTI	"It's apparent that "
	CALL	ARTICLE,WHO,TRUE-VALUE
	PRINTD	WHO
	PRINTR	" didn't expect you to say that."
?CCL3:	CALL	ANYONE-HERE? >WHO
	ZERO?	WHO /?CND1
	CALL	SPOKEN-TO,WHO
	CALL	PERFORM,V?HELLO,WHO
	RTRUE	
?CCL11:	CALL	NOT-LIKELY,WHO,STR?40
	RSTACK	
?CCL8:	CALL	TALK-TO-SELF
	RSTACK	


	.FUNCT	V-HELP
	PRINTR	"(If you're really stuck, maps and InvisiClues (TM) hint booklets are available using the order form that came in your GENERIC package.)"


	.FUNCT	V-HIDE
	PRINTR	"There aren't any good hiding places here."


	.FUNCT	V-KICK
	CALL	HACK-HACK,STR?49
	RSTACK	


	.FUNCT	V-KILL
	FSET?	PRSO,ACTORBIT /?PRG8
	PRINT	CANT
	PRINTI	" attack "
	CALL	ARTICLE,PRSO
	PRINTD	PRSO
	PRINTR	"!"
?PRG8:	PRINTI	"Attacking "
	CALL	ARTICLE,PRSO,TRUE-VALUE
	PRINTD	PRSO
	ZERO?	PRSI /?PRG14
	PRINTI	" with "
	CALL	ARTICLE,PRSI
	PRINTD	PRSI
?PRG14:	PRINTR	" isn't likely to help matters."


	.FUNCT	V-KNOCK
	FSET?	PRSO,DOORBIT \?CCL3
	CALL	NO-ANSWER
	RSTACK	
?CCL3:	FSET?	PRSO,ACTORBIT \?CCL5
	CALL	PERFORM,V?USE,PRSO
	RTRUE	
?CCL5:	CALL	WASTE-OF-TIME
	RSTACK	


	.FUNCT	V-KISS
	PRINTR	"Smack!"


	.FUNCT	V-LAMP-OFF
	CALL	V-LAMP-ON,TRUE-VALUE
	RSTACK	


	.FUNCT	V-LAMP-ON,OFF?=0
	PRINT	CANT
	PRINTI	" turn that "
	ZERO?	OFF? /?PRG8
	PRINTI	"off"
	JUMP	?PRG10
?PRG8:	PRINTI	"on"
?PRG10:	PRINTR	"."


	.FUNCT	V-LEAP
	EQUAL?	PRSO,ROOMS /?CCL3
	PRINTR	"That'd be a cute trick."
?CCL3:	CALL	WASTE-OF-TIME
	RSTACK	


	.FUNCT	V-LEAVE
	EQUAL?	PRSO,ROOMS /?CTR2
	FSET?	PRSO,TAKEBIT /?CCL3
?CTR2:	CALL	DO-WALK,P?OUT
	RTRUE	
?CCL3:	CALL	DONT-HAVE?,PRSO
	ZERO?	STACK \TRUE
	CALL	PERFORM,V?DROP,PRSO
	RTRUE	


	.FUNCT	V-LIE-DOWN
	PRINTR	"This is no time for resting."


	.FUNCT	V-LISTEN
	PRINTI	"At the moment, "
	CALL	ARTICLE,PRSO,TRUE-VALUE
	PRINTD	PRSO
	PRINTR	" makes no sound."


	.FUNCT	V-LOCK
	FSET?	PRSO,DOORBIT /?CTR2
	FSET?	PRSO,CONTBIT \?CCL3
?CTR2:	FSET?	PRSO,OPENBIT \?CCL8
	CALL	YOUD-HAVE-TO,STR?50,PRSO
	RSTACK	
?CCL8:	FSET?	PRSO,LOCKEDBIT \?CCL10
	CALL	BUT-THE,PRSO
	PRINTR	"is already locked."
?CCL10:	CALL	THING-WONT-LOCK,PRSI,PRSO
	RSTACK	
?CCL3:	CALL	CANT-LOCK
	RSTACK	


	.FUNCT	V-UNLOCK
	FSET?	PRSO,DOORBIT /?CTR2
	FSET?	PRSO,CONTBIT \?CCL3
?CTR2:	FSET?	PRSO,OPENBIT \?CCL8
	CALL	ALREADY-OPEN
	RSTACK	
?CCL8:	FSET?	PRSO,LOCKEDBIT /?CCL10
	CALL	BUT-THE,PRSO
	PRINTR	"isn't locked."
?CCL10:	CALL	THING-WONT-LOCK,PRSI,PRSO,TRUE-VALUE
	RSTACK	
?CCL3:	CALL	CANT-LOCK,TRUE-VALUE
	RSTACK	


	.FUNCT	CANT-LOCK,UN?=0
	PRINT	CANT
	PRINTC	32
	ZERO?	UN? /?PRG7
