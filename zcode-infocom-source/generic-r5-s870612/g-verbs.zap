	.FUNCT	V-PUT,?TMP1,?TMP2,?TMP3
	ZERO?	PRSI /?CCL3
	FSET?	PRSI,OPENBIT /?CCL3
	FSET?	PRSI,DOORBIT /?CCL3
	FSET?	PRSI,CONTBIT /?CCL3
	FSET?	PRSI,SURFACEBIT /?CCL3
	PRINT	CANT
	PRINTR	" possibly do that!"
?CCL3:	FSET?	PRSI,OPENBIT /?CCL12
	FSET?	PRSI,SURFACEBIT /?CCL12
	CALL	BUT-THE,PRSI
	PRINTI	"isn't open!"
	CRLF	
	CALL	THIS-IS-IT,PRSI
	RSTACK	
?CCL12:	EQUAL?	PRSI,PRSO \?CCL18
	CALL	WHAT-A-CONCEPT
	RSTACK	
?CCL18:	IN?	PRSO,PRSI \?CCL20
	CALL	BUT-THE,PRSO
	PRINTI	"is already "
	FSET?	PRSI,SURFACEBIT \?PRG28
	PRINTI	"on "
	JUMP	?CND23
?PRG28:	PRINTI	"in "
?CND23:	CALL	ARTICLE,PRSI,TRUE-VALUE
	PRINTD	PRSI
	PRINTR	"!"
?CCL20:	CALL	WEIGHT,PRSI >?TMP3
	CALL	WEIGHT,PRSO
	ADD	?TMP3,STACK >?TMP2
	GETP	PRSI,P?SIZE
	SUB	?TMP2,STACK >?TMP1
	GETP	PRSI,P?CAPACITY
	GRTR?	?TMP1,STACK \?CCL33
	PRINTI	"There's no room."
	CRLF	
	CRLF	
	RTRUE	
?CCL33:	IN?	PRSO,PROTAGONIST /?CCL37
	CALL	ITAKE
	EQUAL?	STACK,FALSE-VALUE,M-FATAL /TRUE
?CCL37:	MOVE	PRSO,PRSI
	FSET	PRSO,TOUCHBIT
	PRINTR	"Done."


