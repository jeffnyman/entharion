	.FUNCT	V-WALK,PT,PTS,STR,OBJ,RM
	ZERO?	P-WALK-DIR \?CCL3
	ZERO?	PRSO /?CCL6
	CALL	PRESUMABLY-YOU-WANT-TO,STR?69,PRSO
	CALL	PERFORM,V?WALK-TO,PRSO
	RTRUE	
?CCL6:	CALL	V-WALK-AROUND
	RTRUE	
?CCL3:	GETPT	HERE,PRSO >PT
	ZERO?	PT /?CCL8
	PTSIZE	PT >PTS
	EQUAL?	PTS,UEXIT \?CCL11
	GETB	PT,REXIT
	CALL	GOTO,STACK
	RSTACK	
?CCL11:	EQUAL?	PTS,NEXIT \?CCL13
	GET	PT,NEXITSTR
	PRINT	STACK
	CRLF	
	RETURN	2
?CCL13:	EQUAL?	PTS,FEXIT \?CCL19
	GET	PT,FEXITFCN
	CALL	STACK >RM
	ZERO?	RM /?PRG23
	CALL	GOTO,RM
	RSTACK	
?PRG23:	RETURN	2
?CCL19:	EQUAL?	PTS,CEXIT \?CCL26
	GETB	PT,CEXITFLAG
	VALUE	STACK
	ZERO?	STACK /?CCL29
	GETB	PT,REXIT
	CALL	GOTO,STACK
	RSTACK	
?CCL29:	GET	PT,CEXITSTR >STR
	ZERO?	STR /?CCL31
	PRINT	STR
	CRLF	
	RETURN	2
?CCL31:	CALL	CANT-GO
	RETURN	2
?CCL26:	EQUAL?	PTS,DEXIT \FALSE
	GETB	PT,DEXITOBJ >OBJ
	FSET?	OBJ,OPENBIT \?CCL42
	GETB	PT,REXIT
	CALL	GOTO,STACK
	RSTACK	
?CCL42:	GET	PT,DEXITSTR >STR
	ZERO?	STR /?CCL44
	PRINT	STR
	CRLF	
	CALL	THIS-IS-IT,OBJ
	RETURN	2
?CCL44:	CALL	ITS-CLOSED,OBJ
	RETURN	2
?CCL8:	CALL	CANT-GO
	RETURN	2


