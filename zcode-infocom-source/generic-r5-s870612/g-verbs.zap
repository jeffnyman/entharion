	CALL	CLOCKER
	ZERO?	STACK /?PRG3
?REP4:	SET	'CLOCK-WAIT,TRUE-VALUE
	RETURN	CLOCK-WAIT


	.FUNCT	V-WAIT-FOR
	LOC	PRSO
	EQUAL?	STACK,HERE,WINNER \?PRG6
	CALL	BUT-THE,PRSO
	PRINTR	"is already here!"
?PRG6:	PRINTR	"You may be waiting quite a while."


	.FUNCT	V-WEAR
	IN?	PRSO,PROTAGONIST \?CCL3
	FSET?	PRSO,WORNBIT \?CCL3
	PRINTI	"You're already wearing "
	JUMP	?CND1
?CCL3:	FSET?	PRSO,WEARBIT /?CCL9
	PRINT	CANT
	PRINTI	" wear "
	JUMP	?CND1
?CCL9:	CALL	DONT-HAVE?,PRSO
	ZERO?	STACK \TRUE
	FSET	PRSO,WORNBIT
	PRINT	OKAY
	PRINTI	"you're now wearing "
?CND1:	CALL	ARTICLE,PRSO,TRUE-VALUE
	PRINTD	PRSO
	PRINTR	"."


	.FUNCT	PRE-TAKE,CONTAINER
	LOC	PRSO >CONTAINER
	IN?	PRSO,WINNER \?CCL3
	PRINTI	"You're already "
	FSET?	PRSO,WORNBIT \?PRG11
	PRINTI	"wear"
	JUMP	?PRG13
?PRG11:	PRINTI	"hold"
?PRG13:	PRINTR	"ing it."
?CCL3:	ZERO?	CONTAINER /?CCL16
	FSET?	CONTAINER,CONTBIT \?CCL16
	FSET?	CONTAINER,OPENBIT /?CCL16
	PRINT	CANT
	PRINTI	" reach into "
	CALL	ARTICLE,CONTAINER,TRUE-VALUE
	PRINTD	CONTAINER
	PRINTR	". It's closed."
?CCL16:	ZERO?	PRSI /?CCL25
	EQUAL?	PRSO,ME \?CCL28
	CALL	PERFORM,V?DROP,PRSI
	RTRUE	
?CCL28:	IN?	PRSO,PRSI /FALSE
	FSET?	PRSI,ACTORBIT \?CCL33
	CALL	BUT-THE,PRSI
	PRINTI	"doesn't have "
	CALL	ARTICLE,PRSO
	PRINTD	PRSO
	JUMP	?PRG38
?CCL33:	CALL	BUT-THE,PRSO
	PRINTI	"isn't in "
	CALL	ARTICLE,PRSI,TRUE-VALUE
	PRINTD	PRSI
?PRG38:	PRINTR	"."
?CCL25:	LOC	WINNER
	EQUAL?	PRSO,STACK \FALSE
	PRINTR	"You're in it!"


	.FUNCT	V-TAKE,CNT
	CALL	ITAKE
	ZERO?	STACK /FALSE
	PRINTI	"Taken."
	CRLF	
	GETP	PRSO,P?VALUE >CNT
	GRTR?	CNT,0 \TRUE
	ADD	SCORE,CNT >SCORE
	PUTP	PRSO,P?VALUE,0
	RTRUE	


	.FUNCT	ITAKE,VB=1,CNT,OBJ
	CALL	THIS-IS-IT,PRSO
	FSET?	PRSO,TAKEBIT /?CCL3
	ZERO?	VB /FALSE
	CALL	PICK-ONE,YUKS
	PRINT	STACK
	CRLF	
	RFALSE	
?CCL3:	CALL	TOO-MUCH-JUNK?,VB
	ZERO?	STACK \FALSE
	MOVE	PRSO,WINNER
	FSET	PRSO,TOUCHBIT
	FCLEAR	PRSO,NDESCBIT
	RTRUE	


	.FUNCT	TOO-MUCH-JUNK?,VB=1,?TMP1
	LOC	PRSO
	IN?	STACK,WINNER /?CCL3
	CALL	WEIGHT,PRSO >?TMP1
	CALL	WEIGHT,WINNER
	ADD	?TMP1,STACK
	GRTR?	STACK,LOAD-ALLOWED \?CCL3
	ZERO?	VB /TRUE
	FIRST?	PROTAGONIST \?PRG13
	PRINTI	"Your load is"
	JUMP	?PRG15
?PRG13:	PRINTI	"It's a little"
?PRG15:	PRINTR	" too heavy."
?CCL3:	CALL	CCOUNT,WINNER
	GRTR?	STACK,FUMBLE-NUMBER \FALSE
	ZERO?	VB /TRUE
	PRINTR	"You're holding too many things already!"


	.FUNCT	CCOUNT,THING,OBJ,CNT=0
	FIRST?	THING >OBJ /?PRG1
?PRG1:	ZERO?	OBJ /?REP2
	FSET?	OBJ,WORNBIT /?CND6
	INC	'CNT
?CND6:	NEXT?	OBJ >OBJ /?PRG1
	JUMP	?PRG1
?REP2:	RETURN	CNT


	.FUNCT	WEIGHT,THING,OBJ,WT=0
	FIRST?	THING >OBJ /?PRG1
?PRG1:	ZERO?	OBJ /?REP2
	EQUAL?	THING,PROTAGONIST \?CCL8
	FSET?	OBJ,WORNBIT \?CCL8
	INC	'WT
	JUMP	?CND6
?CCL8:	CALL	WEIGHT,OBJ
	ADD	WT,STACK >WT
?CND6:	NEXT?	OBJ >OBJ /?PRG1
	JUMP	?PRG1
?REP2:	GETP	THING,P?SIZE
	ADD	WT,STACK >WT
	RETURN	WT


	.FUNCT	DESCRIBE-ROOM,LOOK?=0,V?,STR,AV
	ZERO?	LOOK? /?PRD3
	SET	'V?,LOOK?
	JUMP	?PEN1
?PRD3:	SET	'V?,VERBOSE
?PEN1:	ZERO?	LIT /?CCL6
	SET	'FIRST-WARNING?,TRUE-VALUE
	FSET?	HERE,TOUCHBIT /?CND13
	FSET	HERE,TOUCHBIT
	SET	'V?,TRUE-VALUE
?CND13:	IN?	HERE,ROOMS \?CND15
	PRINTD	HERE
	CRLF	
?CND15:	ZERO?	LOOK? \?CCL20
	ZERO?	SUPER-BRIEF \TRUE
?CCL20:	LOC	WINNER >AV
	ZERO?	V? /?CCL25
	GETP	HERE,P?ACTION
	CALL	STACK,M-LOOK
	ZERO?	STACK \TRUE
?CCL25:	ZERO?	V? /?CCL29
	GETP	HERE,P?LDESC >STR
	ZERO?	STR /?CCL29
	PRINT	STR
	CRLF	
	JUMP	?CND23
?CCL6:	CALL	NOW-BLACK
	ZERO?	FIRST-WARNING? \?PRG11
	RANDOM	100
	LESS?	50,STACK /?CND7
?PRG11:	PRINTI	" You are likely to be eaten by a grue."
	SET	'FIRST-WARNING?,FALSE-VALUE
?CND7:	CRLF	
	RFALSE	
?CCL29:	GETP	HERE,P?ACTION
	CALL	STACK,M-FLASH
?CND23:	EQUAL?	HERE,AV /TRUE
	FSET?	AV,VEHBIT \TRUE
	GETP	AV,P?ACTION
	CALL	STACK,M-LOOK
	RTRUE	


	.FUNCT	GOTO,RM,V?=1,OLIT,OHERE
	SET	'OHERE,HERE
	SET	'OLIT,LIT
	MOVE	WINNER,RM
	SET	'HERE,RM
	CALL	LIT?,HERE >LIT
	ZERO?	OLIT \?CND1
	ZERO?	LIT \?CND1
	ZERO?	FIRST-WARNING? \?CND1
	RANDOM	100
	LESS?	50,STACK /?CND1
	PRINTI	"Oh, no! Something lurked out of the darkness and devoured you!"
	CRLF	
	CALL	FINISH
?CND1:	GETP	HERE,P?ACTION
	CALL	STACK,M-ENTER
	EQUAL?	HERE,RM \TRUE
	ZERO?	V? /TRUE
	CALL	V-FIRST-LOOK
	RTRUE	


	.FUNCT	OTHER-SIDE,DOBJ,P=0,T
?PRG1:	NEXTP	HERE,P >P
	LESS?	P,LOW-DIRECTION /FALSE
	GETPT	HERE,P >T
	PTSIZE	T
	EQUAL?	STACK,DEXIT \?PRG1
	GETB	T,DEXITOBJ
	EQUAL?	STACK,DOBJ \?PRG1
	RETURN	P


	.FUNCT	HACK-HACK,STR
	PRINT	STR
	PRINTC	32
	CALL	ARTICLE,PRSO,TRUE-VALUE
	PRINTD	PRSO
	PRINTC	32
	CALL	PICK-ONE,HO-HUM
	PRINT	STACK
	PRINTR	"."


	.FUNCT	TOO-DARK
	PRINTR	"It's too dark to see!"


	.FUNCT	CANT-GO
	FSET?	HERE,INDOORSBIT \?PRG6
	PRINTI	"There's no exit"
	JUMP	?PRG8
?PRG6:	PRINT	CANT
	PRINTI	" go"
?PRG8:	PRINTR	" that way."


	.FUNCT	NOW-BLACK
	PRINTI	"It is pitch black."
	RTRUE	


	.FUNCT	ALREADY-OPEN
	CALL	ITS-ALREADY,STR?62
	RSTACK	


	.FUNCT	ALREADY-CLOSED
	CALL	ITS-ALREADY,STR?76
	RSTACK	


	.FUNCT	ITS-ALREADY,STR
	PRINTI	"It's already "
	PRINT	STR
	PRINTR	"."


	.FUNCT	REFERRING
	PRINTR	"(Please be more specific.)"


	.FUNCT	WASTE-OF-TIME
	PRINTI	"That would be a "
	CALL	PICK-ONE,USELESSNESS
	PRINT	STACK
	PRINTR	"."

	.ENDI
