	.FUNCT	DESCRIBE-OBJECTS,OBJ,NXT,STR,1ST?=1,TWO?=0,IT?=0
	ZERO?	LIT \?CND1
	CALL	TOO-DARK
	RTRUE	
?CND1:	FIRST?	HERE >OBJ /?KLU89
?KLU89:	ZERO?	OBJ /TRUE
?PRG5:	ZERO?	OBJ /?REP6
	NEXT?	OBJ >NXT /?KLU90
?KLU90:	FSET?	OBJ,INVISIBLE /?CCL11
	FSET?	OBJ,NDESCBIT /?CCL11
	EQUAL?	OBJ,WINNER \?CND10
