	JUMP	?PRG5
?REP6:	FIRST?	HERE >OBJ /?PRG15
?PRG15:	ZERO?	OBJ /?REP16
	NEXT?	OBJ >NXT /?KLU92
?KLU92:	GETP	OBJ,P?FDESC >STR
	ZERO?	STR /?CND20
	FSET?	OBJ,TOUCHBIT /?CND20
	CRLF	
