	FSET?	OBJ,CONTBIT \?PRG74
	PRINTI	" in"
	JUMP	?PRG76
?PRG74:	PRINTI	" on"
?PRG76:	PRINTI	" it"
?CND63:	ZERO?	IT? \?CCL80
	ZERO?	TWO? \?CCL80
	SET	'IT?,OBJ
	JUMP	?CND78
?CCL80:	SET	'TWO?,TRUE-VALUE
	SET	'IT?,FALSE-VALUE
?CND78:	SET	'OBJ,NXT
	JUMP	?PRG35
?CCL39:	ZERO?	IT? /?PRG87
	ZERO?	TWO? \?PRG87
	CALL	THIS-IS-IT,IT?
?PRG87:	PRINTI	" here."
	CRLF	
?CND33:	CALL	MOVE-ALL,DUMMY-OBJECT,HERE
	RSTACK	


	.FUNCT	SEE-ANYTHING-IN?,THING,OBJ,NXT,ANY?=0
	FIRST?	THING >OBJ /?PRG1
?PRG1:	ZERO?	OBJ /?REP2
	FSET?	OBJ,INVISIBLE /?CND6
	FSET?	OBJ,NDESCBIT /?CND6
	EQUAL?	OBJ,WINNER /?CND6
