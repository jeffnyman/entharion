	CRLF	
	MOVE	OBJ,DUMMY-OBJECT
?CND20:	SET	'OBJ,NXT
	JUMP	?PRG15
?REP16:	FIRST?	HERE >OBJ /?PRG26
?PRG26:	ZERO?	OBJ /?REP27
	NEXT?	OBJ >NXT /?KLU94
?KLU94:	GETP	OBJ,P?DESCFCN >STR
	ZERO?	STR /?CND31
	CRLF	
	CALL	STR,M-OBJDESC >STR
	CRLF	
	MOVE	OBJ,DUMMY-OBJECT
?CND31:	SET	'OBJ,NXT
	JUMP	?PRG26
?REP27:	FIRST?	HERE >OBJ /?KLU95
?KLU95:	ZERO?	OBJ /?CND33
?PRG35:	ZERO?	OBJ /?CCL39
	NEXT?	OBJ >NXT /?KLU96
?KLU96:	ZERO?	1ST? /?CCL42
	SET	'1ST?,FALSE-VALUE
	CRLF	
	ZERO?	NXT /?PRG48
	PRINT	YOU-SEE
	JUMP	?CND40
?PRG48:	PRINTI	"There's "
	JUMP	?CND40
?CCL42:	ZERO?	NXT /?PRG55
	PRINTI	", "
	JUMP	?CND40
?PRG55:	PRINTI	" and "
?CND40:	CALL	ARTICLE,OBJ
	PRINTD	OBJ
	FSET?	OBJ,ONBIT \?CND59
	PRINTI	" (providing light)"
?CND59:	CALL	SEE-INSIDE?,OBJ
	ZERO?	STACK /?CND63
	CALL	SEE-ANYTHING-IN?,OBJ
	ZERO?	STACK /?CND63
	PRINTI	" with "
