            ];

Cheese -> -> Stilton "Stilton"
    with    name 'stilton' 'stil' 'stilt',
            description "A firm blue-mould cheese with narrow blue-green
                veins and a moist creamy texture.",
            before [;
                Lick,Taste:
                    "Rich and tangy, with a piquant aftertaste.";
                Smell:
                    "The Stilton has a rich earthy aroma.";
                Touch:
                    "Firm, with a moist creamy texture.";
            ],
            after [;
